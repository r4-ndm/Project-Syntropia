pkgbase = syntropia
	pkgdesc = Transform CachyOS into Syntropia OS — rebranded, audio-optimised, with Wine/yabridge VST3 support
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/r4-ndm/Project-Syntropia
	arch = any
	license = MIT
	makedepends = python-installer
	makedepends = python-setuptools
	makedepends = python-wheel
	depends = python
	depends = python-click
	optdepends = wine-staging: run Windows audio applications (transform installs this)
	optdepends = winetricks: install Windows DLLs and components
	optdepends = yabridge: bridge Windows VST3 plugins to Linux
	optdepends = yabridgectl: manage yabridge-bridged plugins
	optdepends = fastfetch: display the Syntropia terminal logo at login
	optdepends = snapper: create pre-transform snapshots (recommended)

pkgname = syntropia
