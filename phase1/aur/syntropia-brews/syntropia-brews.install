post_install() {
    cat << 'MSG'

  🍺  syntropia-brews has been installed!

  Install your first Windows VST/DAW:

      syntropia list-brews          # see the seed registry
      syntropia install surge       # free, good first test

  The install runs Wine + yabridge; run --check first:

      syntropia install <brew> --check

  Docs: https://github.com/r4-ndm/Project-Syntropia

MSG
}

post_upgrade() {
    # pacman passes the new version as $1 — no %v substitution.
    cat << MSG

  🍺  syntropia-brews upgraded to $1!

  Dry-run before a real install, as usual:

      syntropia install <brew> --check

MSG
}

pre_remove() {
    cat << 'MSG'

  🗑️  Removing syntropia-brews.

  Your Wine prefixes, bridged VST3s, and brew manifests in
  ~/.config/syntropia/ and ~/.local/share/syntropia/ are left
  untouched — they live in your home directory.

MSG
}
