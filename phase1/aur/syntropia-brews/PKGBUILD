# Maintainer: Syntropia Team <hello@project-syntropia.io>
# Contributor: r4-ndm
#
# syntropia-brews — the Syntropia *app helper*: installs Windows DAWs and VST
# plugins under Wine + yabridge from `.brew` manifests. Depends on
# syntropia-cli (the `syntropia` command shell) but does NOT pull in the
# rebrand — this is the package for users who just want the app installer.
#
# Build/test locally: drop the release tarball into this directory, then
#   cd phase1/aur/syntropia-brews
#   makepkg -si
#
# The source tarball is shared by all three Syntropia packages; regenerate
# it from the repo root with — three rules keep the sha256 STABLE across
# rebuilds: (1) phase1/aur is excluded — it's the packaging itself, which
# lives in the AUR repos, not in the source tarball; (2) archive HEAD^{tree},
# not HEAD — HEAD embeds a commit-id pax comment that changes the hash on
# every commit even when the files don't; (3) ship a plain uncompressed
# .tar, not .tar.gz — gzip output varies by zlib version, so a compressed
# hash differs between machines. --mtime is pinned for the same reason:
#   git archive --format=tar --prefix="syntropia-$pkgver/" \
#     --mtime="2026-08-14 12:00:00 UTC" \
#     -o release/syntropia-$pkgver.tar HEAD^{tree} -- . ':(exclude)phase1/aur'

pkgname=syntropia-brews
pkgrel=1
pkgdesc="Syntropia app helper — install Windows DAWs and VSTs via Wine + yabridge"
arch=('any')
url="https://github.com/r4-ndm/Project-Syntropia"
install=syntropia-brews.install
license=('MIT')
depends=('syntropia-cli' 'python' 'python-textual')
optdepends=(
  'wine-staging: run Windows audio applications'
  'winetricks: install Windows DLLs and components'
  'yabridge: bridge Windows VST3 plugins to Linux'
  'yabridgectl: manage yabridge-bridged plugins'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')

# pkgver is the release version shared by all three Syntropia packages. It
# matches phase1/cli/syntropia/__init__.py (the version-lockstep test pins
# them together) — bump it here on each release.
pkgver=0.1.0

source=("syntropia-$pkgver.tar::https://github.com/r4-ndm/Project-Syntropia/releases/download/v$pkgver/syntropia-$pkgver.tar")
sha256sums=('358e6be4d4e9c39b26a6e3600033f61e2bbe5ba9c9ef0829d1677fdcfad91802')

build() {
    _repo="$srcdir/syntropia-$pkgver"

    msg "Copying phase1/cli/ -> $srcdir/cli"
    cp -r "$_repo/phase1/cli" "$srcdir/cli"
    chmod -R u+w "$srcdir/cli"
    rm -rf "$srcdir/cli/syntropia.egg-info"
    find "$srcdir/cli" -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true

    cd "$srcdir/cli/brews"
    msg "Building syntropia-brews wheel..."
    python -m build --wheel --no-isolation --outdir="$srcdir/dist" .
}

package() {
    _repo="$srcdir/syntropia-$pkgver"

    msg "Installing syntropia-brews..."
    python -m installer --destdir="$pkgdir" "$srcdir/dist/"*.whl

    # -- Brew manifests (seed registry) ---------------------------------
    _brews="$pkgdir/usr/share/syntropia/brews"
    install -d "$_brews"
    msg "Installing seed brew manifests..."
    for brew in "$_repo/phase1/brews/"*.brew; do
        install -m644 "$brew" "$_brews/"
    done

    # -- Systemd units --------------------------------------------------
    _units="$pkgdir/usr/lib/systemd/system"
    install -d "$_units"
    msg "Installing systemd units..."
    for unit in syntropia-registry-sync.service syntropia-registry-sync.timer; do
        if [[ -f "$_repo/phase1/services/$unit" ]]; then
            install -m644 "$_repo/phase1/services/$unit" "$_units/"
        fi
    done

    # -- License --------------------------------------------------------
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cat > "$pkgdir/usr/share/licenses/$pkgname/LICENSE" <<'LICEOF'
MIT License

Copyright (c) 2025-2026 Syntropia Project

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.
LICEOF
}
