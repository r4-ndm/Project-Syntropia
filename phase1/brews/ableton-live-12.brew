# Ableton Live 12 — version 12.2 (latest as of 2026-08).
#
# Uses the shibco/ableton-linux patched Wine which fixes embedded
# Python stdlib resolution and works with both Suite and Trial installers.
#
# ═══ PREREQUISITES ═══
# 1. Download the installer from your Ableton account:
#      https://www.ableton.com/account/
#    Place it in ~/Downloads/ (the brew auto-discovers it).
# 2. You need a valid Ableton license to activate after install.

[brew]
name = "Ableton Live 12"
version = "12.2"
category = "daw"
maintainer = "Syntropia Team <hello@project-syntropia.io>"

[source]
filename = "ableton_live_suite_*.zip"
url = "https://cdn-downloads.ableton.com/channels/12.2/ableton_live_suite_12.2_64.zip"
look_in = ["~/Downloads", "/tmp"]

[wine]
version = "ableton-wine"
prefix = "~/.local/share/syntropia/prefixes/ableton"
arch = "win64"

[wine.overrides]
d3d11 = "builtin"
dxgi = "builtin"
d3d10core = "builtin"
d2d1 = "builtin"
dcomp = "builtin"
dwrite = "builtin"
d3d9 = "builtin"
d3d8 = "builtin"
wininet = "builtin"
"winemenubuilder.exe" = "d"

[winetricks]
packages = [
  "corefonts",
  "tahoma",
  "vcrun2022",
  "win11",
]

[yabridge]
enabled = false
plugin_dirs = []

[environment]
LANG = "en_US.UTF-8"
WINE_DISABLE_CRASH_DIALOG = "1"

[install]
commands = [
  "mkdir -p \"$WINEPREFIX/drive_c/ableton_installer\"",
  "unzip -o \"$SYNTROPIA_SOURCE\" -d \"$WINEPREFIX/drive_c/ableton_installer/\"",
  "SHIBCO_URL='https://github.com/shibco/ableton-linux/releases/latest/download/install-ableton-latest.run'; SHIBCO_DST=/tmp/syntropia-ableton-wine.run; if [ ! -x /opt/ableton-wine/bin/wine ]; then echo 'Installing shibco patched Wine (112MB, one-time)...'; curl -L -o \"$SHIBCO_DST\" \"$SHIBCO_URL\" && sudo bash \"$SHIBCO_DST\" --runtime-only && echo 'Shibco wine installed'; else echo 'Shibco wine already installed'; fi",
  "INSTALLER=$(find \"$WINEPREFIX/drive_c/ableton_installer\" -maxdepth 1 -name 'Ableton Live*.exe' ! -name 'unins*' | head -1); echo \"Installer: $INSTALLER\"; /opt/ableton-wine/bin/wine \"$INSTALLER\" /SILENT /SUPPRESSMSGBOXES /NORESTART & WINE_PID=$!; for i in $(seq 1 60); do sleep 10; if find \"$WINEPREFIX/drive_c/ProgramData/Ableton\" -name 'Ableton Live*.exe' ! -name '*Install*' ! -name 'unins*' 2>/dev/null | grep -q .; then echo 'Ableton files detected, finishing install...'; /opt/ableton-wine/bin/wineserver -k 2>/dev/null; break; fi; done; wait $WINE_PID 2>/dev/null; /opt/ableton-wine/bin/wineserver -k 2>/dev/null; echo 'Installer step complete'",
  "ABLEX=$(find \"$WINEPREFIX/drive_c/ProgramData/Ableton\" -name 'Ableton Live*.exe' ! -name '*Install*' ! -name 'unins*' 2>/dev/null | head -1); echo \"Ableton at: $ABLEX\"",
  "LIVEVER=$(find \"$WINEPREFIX/drive_c/users/$USER/AppData/Roaming/Ableton\" -maxdepth 1 -name 'Live *' -type d 2>/dev/null | head -1); if [ -n \"$LIVEVER\" ]; then mkdir -p \"$LIVEVER/Preferences\" && printf '%s\\n' '-_Feature.UseGpuRenderer' '-DontLoadMaxForLiveAtStartup' '-DontCombineAPCs' > \"$LIVEVER/Preferences/Options.txt\"; else echo 'No AppData/Ableton dir yet — Options.txt skipped (will be created on first launch)'; fi",
  "/opt/ableton-wine/bin/wine reg add 'HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' /v AppsUseLightTheme /t REG_DWORD /d 1 /f && /opt/ableton-wine/bin/wine reg add 'HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' /v SystemUsesLightTheme /t REG_DWORD /d 1 /f",
  "mkdir -p ~/.local/share/applications ~/.local/bin",
  "ABLEX=$(find \"$WINEPREFIX/drive_c/ProgramData/Ableton\" -name 'Ableton Live*.exe' ! -name '*Install*' ! -name 'unins*' 2>/dev/null | head -1); ABLENAME=$(basename \"$ABLEX\" .exe); printf '#!/bin/sh\\nWINEPREFIX=%s /opt/ableton-wine/bin/wineserver -k 2>/dev/null\\npkill -9 -f \"%s\" 2>/dev/null\\nnotify-send \"Ableton\" \"Force quit complete\" 2>/dev/null\\n' \"$WINEPREFIX\" \"$ABLENAME\" > ~/.local/bin/ableton-kill && chmod +x ~/.local/bin/ableton-kill",
  "ABLEX=$(find \"$WINEPREFIX/drive_c/ProgramData/Ableton\" -name 'Ableton Live*.exe' ! -name '*Install*' ! -name 'unins*' 2>/dev/null | head -1); ABLENAME=$(basename \"$ABLEX\"); ABLEDIR=$(dirname \"$ABLEX\"); WINDIR=$(echo \"$ABLEDIR\" | sed \"s|$WINEPREFIX/drive_c/|C:/|\"); WMCLASS=$(echo \"$ABLENAME\" | tr '[:upper:]' '[:lower:]' | sed 's/ .exe/.exe/'); printf '[Desktop Entry]\\nName=Ableton Live 12\\nComment=Digital Audio Workstation (Ableton-Wine)\\nIcon=ableton-live-12\\nExec=env WINEPREFIX=%s WINE_DISABLE_CRASH_DIALOG=1 /opt/ableton-wine/bin/wine start /d \"%s\" \"%s\"\\nType=Application\\nCategories=Audio;AudioVideo;\\nStartupWMClass=%s\\nActions=quit-wine\\n\\n[Desktop Action quit-wine]\\nName=Force Quit\\nExec=%s/.local/bin/ableton-kill\\nIcon=process-stop\\n' \"$WINEPREFIX\" \"$WINDIR\" \"$ABLENAME\" \"$WMCLASS\" \"$HOME\" > ~/.local/share/applications/ableton-live-12.desktop",
  "mkdir -p ~/.local/share/icons/hicolor/256x256/apps && ICOSRC=$(find \"$WINEPREFIX/drive_c/ProgramData/Ableton\" -name '*.ico' 2>/dev/null | head -1) && ICODST=~/.local/share/icons/hicolor/256x256/apps/ableton-live-12 && if command -v magick >/dev/null 2>&1 && [ -f \"$ICOSRC\" ]; then magick \"$ICOSRC\" -resize 256x256 \"$ICODST.png\" 2>/dev/null; [ -f \"$ICODST-0.png\" ] && cp \"$(ls -S $ICODST-*.png 2>/dev/null | head -1)\" \"$ICODST.png\" && rm -f \"$ICODST-\"*.png; fi; echo 'icon done'",
]
