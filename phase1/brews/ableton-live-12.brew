# Ableton Live 12 — version 12.2 (latest as of 2026-08).
#
# Uses the syntropia-wine (giang17/wine d2d1-dcomp) patched Wine. This is the
# stack that is proven to launch on this machine: giang17's d2d1-dcomp build
# plus WINE_D3D_CONFIG=csmt=0x1 and WINED3D_DCOMP_FORCE_FULL_REDRAW=1 in the
# launcher. The shibco/ableton-linux runtime was tried (08-08) but Live exits
# silently right after "Options: initialization done" with it — reverted.
#
# ═══ PREREQUISITES ═══
# 1. Download the installer from your Ableton account:
#      https://www.ableton.com/account/
#    Place it in ~/Downloads/ (the brew auto-discovers it).
#    NOTE: the public CDN link serves the Trial installer even though the
#    filename says "suite" — the real Suite installer comes from your account.
# 2. You need a valid Ableton license to activate after install.

[brew]
name = "Ableton Live 12"
version = "12.2"
category = "daw"
maintainer = "Syntropia Team <hello@project-syntropia.io>"

[source]
filename = "ableton_live_suite_*.zip"
url = "https://cdn-downloads.ableton.com/channels/12.2/ableton_live_suite_12.2_64.zip"
look_in = ["~/Downloads", "/tmp"]

[wine]
version = "syntropia-wine"
prefix = "~/.local/share/syntropia/prefixes/ableton"
arch = "win64"

[wine.overrides]
d3d11 = "builtin"
dxgi = "builtin"
d3d10core = "builtin"
d2d1 = "builtin"
dcomp = "builtin"
dwrite = "builtin"
d3d9 = "builtin"
d3d8 = "builtin"
wininet = "builtin"
"winemenubuilder.exe" = "d"

[winetricks]
packages = [
  "corefonts",
  "tahoma",
  "vcrun2022",
  "win11",
]

[yabridge]
enabled = false
plugin_dirs = []

[environment]
LANG = "en_US.UTF-8"
WINE_DISABLE_CRASH_DIALOG = "1"

[install]
commands = [
  "mkdir -p \"$WINEPREFIX/drive_c/ableton_installer\"",
  "unzip -o \"$SYNTROPIA_SOURCE\" -d \"$WINEPREFIX/drive_c/ableton_installer/\"",
  "INSTALLER=$(find \"$WINEPREFIX/drive_c/ableton_installer\" -maxdepth 1 -name 'Ableton Live*.exe' ! -name 'unins*' | head -1); echo \"Installer: $INSTALLER\"; /opt/syntropia-wine/bin/wine \"$INSTALLER\" /SILENT /SUPPRESSMSGBOXES /NORESTART '/MERGETASKS=!audiodriver'; echo \"Installer exited rc=$?\"; /opt/syntropia-wine/bin/wineserver -k 2>/dev/null; echo 'Installer step complete'",
  "ABLEX=$(find \"$WINEPREFIX/drive_c/ProgramData/Ableton\" -name 'Ableton Live*.exe' ! -name '*Install*' ! -name 'unins*' 2>/dev/null | head -1); PROGDIR=$(dirname \"$ABLEX\"); echo \"Ableton at: $ABLEX\"; if [ ! -f \"$PROGDIR/python311.zip\" ]; then echo 'Downloading Python 3.11 stdlib for embedded interpreter...'; curl -L -o /tmp/python311-embed.zip 'https://www.python.org/ftp/python/3.11.9/python-3.11.9-embed-amd64.zip' && unzip -o /tmp/python311-embed.zip python311.zip -d \"$PROGDIR/\" && echo 'Python stdlib installed'; else echo 'Python stdlib already present'; fi",
  "LIVEVER=$(find \"$WINEPREFIX/drive_c/users/$USER/AppData/Roaming/Ableton\" -maxdepth 1 -name 'Live *' -type d 2>/dev/null | head -1); if [ -n \"$LIVEVER\" ]; then mkdir -p \"$LIVEVER/Preferences\" && printf '%s\\n' '-_Feature.UseGpuRenderer' '-DontLoadMaxForLiveAtStartup' '-DontCombineAPCs' > \"$LIVEVER/Preferences/Options.txt\"; else echo 'No AppData/Ableton dir yet — Options.txt skipped (will be created on first launch)'; fi",
  "/opt/syntropia-wine/bin/wine reg add 'HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' /v AppsUseLightTheme /t REG_DWORD /d 1 /f && /opt/syntropia-wine/bin/wine reg add 'HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' /v SystemUsesLightTheme /t REG_DWORD /d 1 /f",
  "mkdir -p ~/.local/share/applications ~/.local/bin",
  "ABLEX=$(find \"$WINEPREFIX/drive_c/ProgramData/Ableton\" -name 'Ableton Live*.exe' ! -name '*Install*' ! -name 'unins*' 2>/dev/null | head -1); ABLENAME=$(basename \"$ABLEX\" .exe); printf '#!/bin/sh\\nWINEPREFIX=%s /opt/syntropia-wine/bin/wineserver -k 2>/dev/null\\npkill -9 -f \"%s\" 2>/dev/null\\nnotify-send \"Ableton\" \"Force quit complete\" 2>/dev/null\\n' \"$WINEPREFIX\" \"$ABLENAME\" > ~/.local/bin/ableton-kill && chmod +x ~/.local/bin/ableton-kill",
  "ABLEX=$(find \"$WINEPREFIX/drive_c/ProgramData/Ableton\" -name 'Ableton Live*.exe' ! -name '*Install*' ! -name 'unins*' 2>/dev/null | head -1); ABLENAME=$(basename \"$ABLEX\"); ABLEDIR=$(dirname \"$ABLEX\"); WINDIR=$(echo \"$ABLEDIR\" | sed \"s|$WINEPREFIX/drive_c/|C:/|\"); WMCLASS=$(echo \"$ABLENAME\" | tr '[:upper:]' '[:lower:]' | sed 's/ .exe/.exe/'); printf '[Desktop Entry]\\nName=Ableton Live 12\\nComment=Digital Audio Workstation (Syntropia Wine)\\nIcon=ableton-live-12\\nExec=env WINEPREFIX=%s WINEDLLOVERRIDES=\"d3d11=b,dxgi=b,d3d10core=b,d2d1=b,dcomp=b,dwrite=b,d3d9=b,d3d8=b,winemenubuilder.exe=d\" WINE_D3D_CONFIG=csmt=0x1 WINED3D_DCOMP_FORCE_FULL_REDRAW=1 WINE_DISABLE_CRASH_DIALOG=1 /opt/syntropia-wine/bin/wine start /d \"%s\" \"%s\"\\nType=Application\\nCategories=Audio;AudioVideo;\\nStartupWMClass=%s\\nActions=quit-wine\\n\\n[Desktop Action quit-wine]\\nName=Force Quit\\nExec=%s/.local/bin/ableton-kill\\nIcon=process-stop\\n' \"$WINEPREFIX\" \"$WINDIR\" \"$ABLENAME\" \"$WMCLASS\" \"$HOME\" > ~/.local/share/applications/ableton-live-12.desktop",
  "mkdir -p ~/.local/share/icons/hicolor/256x256/apps && ICOSRC=$(find \"$WINEPREFIX/drive_c/ProgramData/Ableton\" -name '*.ico' 2>/dev/null | head -1) && ICODST=~/.local/share/icons/hicolor/256x256/apps/ableton-live-12 && if command -v magick >/dev/null 2>&1 && [ -f \"$ICOSRC\" ]; then magick \"$ICOSRC\" -resize 256x256 \"$ICODST.png\" 2>/dev/null; [ -f \"$ICODST-0.png\" ] && cp \"$(ls -S $ICODST-*.png 2>/dev/null | head -1)\" \"$ICODST.png\" && rm -f \"$ICODST-\"*.png; fi; echo 'icon done'",
]
