# Vital Wavetable Synth — free download from account.vital.audio (account required).

[brew]
name = "Vital Wavetable Synth"
version = "1.5.5"
category = "vst3_synth"
maintainer = "Syntropia Team <hello@project-syntropia.io>"

[wine]
version = "cachyos-wine"
prefix = "~/.local/share/syntropia/prefixes/vital"
arch = "win64"

[wine.overrides]
gdiplus = "native"

[winetricks]
packages = ["corefonts", "gdiplus"]

[yabridge]
enabled = true
plugin_dirs = ["~/VST3"]

[environment]
WINEDLLOVERRIDES = "winemenubuilder.exe=d"
LANG = "en_US.UTF-8"

[install]
# VitalInstaller.exe is an Inno Setup installer: /S is an NSIS flag and would
# open the GUI and block. /VERYSILENT runs it headless.
commands = [
  "wine /tmp/Vital-Setup.exe /VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
  "mkdir -p \"$HOME/VST3\"",
  "cp -r \"$WINEPREFIX/drive_c/Program Files/Common Files/VST3/Vital.vst3\" \"$HOME/VST3/\"",
]
