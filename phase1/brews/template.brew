# Syntropia brew manifest template
# Copy this file, fill it in, and drop it in ~/.config/syntropia/brews/
# Full reference: phase1/plan.md -> '.brew' Specification Schema

[brew]
name = "Example App"
version = "1.0.0"
category = "vst3_synth"          # vst3_synth | vst3_effect | daw | utility
maintainer = "Syntropia Team <hello@project-syntropia.io>"

# [source] tells syntropia where to find the installer file.
# - filename: glob pattern to match in look_in directories
# - url: if the file isn't found locally, syntropia downloads it
# - look_in: directories to search (default: ~/Downloads)
# The resolved path is available as $SYNTROPIA_SOURCE in install commands.
[source]
# filename = "example_setup_*.exe"
# url = "https://example.com/installer.exe"
# look_in = ["~/Downloads", "/tmp"]

[wine]
version = "cachyos-wine"
prefix = "~/.local/share/syntropia/prefixes/example"
arch = "win64"                   # win32 | win64

[wine.overrides]
# d2d1 = "disabled"              # bypass Wine Direct2D rendering bugs
# gdiplus = "native"             # native GDI+ for text / knob anti-aliasing

[winetricks]
packages = ["corefonts"]

[yabridge]
enabled = true
plugin_dirs = ["~/.vst3/Syntropia"]

[environment]
WINEDLLOVERRIDES = "winemenubuilder.exe=d"
LANG = "en_US.UTF-8"

[install]
commands = [
  # Use $SYNTROPIA_SOURCE to reference the auto-discovered installer file:
  # "wine \"$SYNTROPIA_SOURCE\" /S",
  # "cp -r '$WINEPREFIX/drive_c/Program Files/Common Files/VST3/Example.vst3' ~/.vst3/Syntropia/",
]
