# Freebuff desktop app local data (conversations database — never commit)
.freebuff/

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Locally installed AI agent skills (keep local for now — not part of the repo)
.agents/*
# Ignore all community-installed skills by default...
.agents/skills/*
# ...but Project Syntropia's own skills ARE tracked
!.agents/skills/iso-builder/
!.agents/skills/iso-builder/**
skills-lock.json

# Local agent tooling config (machine-specific)
.claude/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Python build artifacts
*.egg-info/
build/
__pycache__/

# ISO build artifacts (never commit the built ISOs — huge binaries)
*.iso
iso/work/
iso/out/

# Release source tarballs (regenerated via git archive before each release)
release/

# Go TUI dialog binary (built on demand from phase1/wizard/dialog)
phase1/wizard/dialog/syntropia-apps-tui

# Future-phase planning docs (not ready for public eyes yet)
phase2/
phase3/
