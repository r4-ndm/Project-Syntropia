# Freebuff desktop app local data (conversations database — never commit)
.freebuff/

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# ISO build artifacts (never commit built images; ~3 GB each)
*.iso
iso/work/
iso/out/

# Release source tarballs (regenerated via git archive before each release)
release/

# Agent tooling: checkout-local config, and community skills installed from
# elsewhere. Syntropia's OWN skills are tracked — re-included below.
# skills-lock.json IS tracked: it records the vendored skill pins.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/iso-builder/
!.agents/skills/iso-builder/**
!.agents/skills/aur-audit/
!.agents/skills/aur-audit/**
.claude/

